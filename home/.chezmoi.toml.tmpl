{{- /* Profile: CHEZMOI_PROFILE env, else prompt once (skip when non-interactive / cloud). */ -}}
{{- $envProfile := env "CHEZMOI_PROFILE" -}}
{{- $nonInteractive := or (eq (env "CHEZMOI_NON_INTERACTIVE") "1") (eq (env "CI") "true") (eq $envProfile "cloud") -}}
{{- $profile := $envProfile -}}
{{- if not $profile -}}
{{-   if $nonInteractive -}}
{{-     $profile = "personal" -}}
{{-   else -}}
{{-     $profile = promptStringOnce . "profile" "Dotfiles profile (personal/server/cloud/minimal)" "personal" -}}
{{-   end -}}
{{- end -}}
{{- if not (or (eq $profile "personal") (eq $profile "server") (eq $profile "cloud") (eq $profile "minimal")) -}}
{{-   $profile = "personal" -}}
{{- end -}}

{{- /* Single-repo layout: content lives at the chezmoi working tree (sibling of home/). */ -}}
{{- $codeDir := env "CODE_DIR" | default (printf "%s/code" .chezmoi.homeDir) -}}
{{- $dotDir := env "DOT_DIR" | default .chezmoi.workingTree -}}

# Generated by chezmoi from .chezmoi.toml.tmpl — do not edit by hand.

[data]
    profile = {{ $profile | quote }}
    nonInteractive = {{ if or $nonInteractive (eq $profile "cloud") (eq $profile "server") }}true{{ else }}false{{ end }}
    code_dir = {{ $codeDir | quote }}
    dot_dir = {{ $dotDir | quote }}
