#!/usr/bin/env zsh
# chezmoi: run_onchange — verify BWS secrets path (does not export secrets)
{{ $cfg := index . .profile -}}
{{ if $cfg.deploy.secrets_env -}}
set -euo pipefail
export DOT_DIR="{{ .dot_dir }}"
export CHEZMOI_PROFILE="{{ .profile }}"
CHEZMOI_ROOT="{{ .chezmoi.workingTree }}"
source "$CHEZMOI_ROOT/scripts/lib.sh"

BWS_TOKEN_FILE="${BWS_TOKEN_FILE:-$HOME/.config/bws/token}"
if [[ -f "$BWS_TOKEN_FILE" ]]; then
  ok "BWS token present at $BWS_TOKEN_FILE"
else
  warn "BWS token missing — run: secrets-init bws"
  warn "  (or: secrets-edit). Secrets are NOT globally exported; use setup-envrc per project."
fi

# Soft check that bws CLI exists when deploy.bws expected
{{ if $cfg.deploy.bws }}
if ! command -v bws &>/dev/null; then
  warn "bws CLI not found — install via install component or: cargo install bws / brew install bws"
fi
{{ end }}
{{ end -}}
