#!/usr/bin/env zsh
# chezmoi: run_onchange — verify secrets backend (does not export secrets)
{{ $cfg := index . .profile -}}
{{ if $cfg.deploy.secrets_env -}}
set -euo pipefail
export DOT_DIR="{{ .dot_dir }}"
export CHEZMOI_PROFILE="{{ .profile }}"
CHEZMOI_ROOT="{{ .chezmoi.workingTree }}"
source "$CHEZMOI_ROOT/scripts/lib.sh"
source "$CHEZMOI_ROOT/scripts/helpers/dotfiles_secrets.sh"

backend="$(dotfiles_secrets_backend)"
case "$backend" in
  bws)
    ok "Secrets backend: bws ($(dotfiles_secrets_bws_token_file))"
    ;;
  file)
    ok "Secrets backend: file ($(dotfiles_secrets_enc_file))"
    ;;
  fnox)
    ok "Secrets backend: fnox ($(dotfiles_secrets_fnox_config))"
    ;;
  none)
    warn "No secrets backend — run: secrets-init file   # or: secrets-init fnox | secrets-init bws"
    warn "  Secrets are NOT globally exported; use setup-envrc per project."
    ;;
  *)
    warn "Unknown secrets backend: $backend"
    ;;
esac

if ! command -v age &>/dev/null; then
  warn "age not found — needed for file/fnox backends"
fi

# Soft check that bws CLI exists when deploy.bws expected
{{ if $cfg.deploy.bws }}
if ! command -v bws &>/dev/null; then
  warn "bws CLI not found — install via install component or: cargo install bws / brew install bws"
fi
{{ end }}
{{ end -}}
