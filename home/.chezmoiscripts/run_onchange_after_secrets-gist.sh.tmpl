#!/usr/bin/env zsh
# chezmoi: run_onchange — gist sync + daily automation
{{ $cfg := index . .profile -}}
{{ if $cfg.deploy.secrets -}}
set -euo pipefail
export DOT_DIR="{{ .dot_dir }}"
export CHEZMOI_PROFILE="{{ .profile }}"
CHEZMOI_ROOT="{{ .chezmoi.workingTree }}"
source "$CHEZMOI_ROOT/scripts/lib.sh"

log_section "SYNCING GIST (chezmoi)"
mkdir -p "$HOME/.ssh/controlmasters"
sync_gist || warn "Gist sync failed (continuing anyway)"

if [[ -f "$DOT_DIR/scripts/cleanup/setup_gist_sync.sh" ]]; then
  "$DOT_DIR/scripts/cleanup/setup_gist_sync.sh" || warn "Failed to setup automated gist sync"
fi
ok "gist sync configured"
{{ end -}}
