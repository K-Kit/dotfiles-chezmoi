#!/usr/bin/env bash
# chezmoi: run_once — verify content is present in this single-repo checkout
set -euo pipefail

DOT_DIR="{{ .dot_dir }}"

if [[ -d "$DOT_DIR/config" ]]; then
  echo "  ✓ dotfiles content present at $DOT_DIR"
  exit 0
fi

echo "  ✗ Expected config/ under $DOT_DIR (chezmoi working tree)." >&2
echo "    Clone https://github.com/K-Kit/dotfiles-chezmoi and apply with:" >&2
echo "      CHEZMOI_PROFILE=personal chezmoi --source <clone> apply" >&2
exit 1
