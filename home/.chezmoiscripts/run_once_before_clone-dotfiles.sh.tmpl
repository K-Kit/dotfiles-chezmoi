#!/usr/bin/env bash
# chezmoi: run_once — ensure the dotfiles-ai content repo exists before apply
set -euo pipefail

DOT_DIR="{{ .dot_dir }}"
REPO="{{ .dotfiles_repo }}"
BRANCH="{{ .dotfiles_branch }}"

if [[ -d "$DOT_DIR/config" ]]; then
  echo "  ✓ dotfiles content repo present at $DOT_DIR"
  exit 0
fi

echo "  Cloning dotfiles content repo → $DOT_DIR"
mkdir -p "$(dirname "$DOT_DIR")"
git clone --branch "$BRANCH" "$REPO" "$DOT_DIR"
echo "  ✓ cloned $REPO @ $BRANCH"
